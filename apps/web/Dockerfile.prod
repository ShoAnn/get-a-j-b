# syntax=docker/dockerfile:1.7

# Production web image. Build context MUST be the repo root, e.g.:
#   docker build -f apps/web/Dockerfile.prod .
# (compose prod overlay already sets this). Deps are installed workspace-aware
# via `npm ci` against the committed root package-lock.json.

FROM node:20-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci

FROM node:20-alpine AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY apps/web ./apps/web

# Runs with cwd=apps/web; NEXT_PUBLIC_* vars are baked here if needed.
# Browser traffic goes through Next /api route handlers (API_URL, server-side),
# so no public API URL is required at build time.
RUN npm run build --workspace=web

FROM node:20-alpine AS prod

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup -S nodejs && adduser -S nextjs -G nodejs

# Monorepo standalone layout: server lives at apps/web/server.js.
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/health | grep -q ok

CMD ["node", "apps/web/server.js"]

# Database
DB_USER=postgres
DB_PASSWORD=change_me_in_production
DB_NAME=getajob
DB_EXTERNAL_PORT=5433
POSTGRES_URL=postgres://postgres:postgres@localhost:5433/getajob?sslmode=disable

# API
API_EXTERNAL_PORT=8080
PORT=8080
# REQUIRED in production: min 32 chars of crypto randomness.
# Generate with: openssl rand -base64 48
# The API refuses to boot with the placeholder below unless
# ALLOW_INSECURE_JWT=true (dev only, never in prod).
JWT_SECRET_KEY=change_me_in_production__generate_min_32_chars
# Comma-separated list of browser-facing origins allowed to call the Go API
# directly. The Next.js app proxies via /api route handlers, so browsers
# normally never hit the API cross-origin — keep this tight in prod, e.g.
# CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Web / Frontend
WEB_EXTERNAL_PORT=3000
# Server-side URL the Next.js container uses to reach the API (internal docker DNS).
API_URL=http://api:8080
# NOTE: NEXT_PUBLIC_API_URL is legacy and unused — all browser traffic goes
# through Next.js /api route handlers which use API_URL server-side.

# Adminer (dev only — not started by docker-compose.prod.yaml)
ADMINER_EXTERNAL_PORT=8081

# Migration path (optional; prod image default is /app/internal/db/migrations)
MIGRATIONS_PATH=./internal/db/migrations
